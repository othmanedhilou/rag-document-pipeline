{
  "name": "tr_document_uploaded",
  "properties": {
    "type": "BlobEventsTrigger",
    "typeProperties": {
      "blobPathBeginsWith": "/documents/blobs/",
      "ignoreEmptyBlobs": true,
      "scope": "/subscriptions/<subscription-id>/resourceGroups/rg-docpipe-dev/providers/Microsoft.Storage/storageAccounts/stdocpipedev",
      "events": ["Microsoft.Storage.BlobCreated", "Microsoft.Storage.BlobDeleted"]
    },
    "pipelines": [
      {
        "pipelineReference": { "referenceName": "pl_index_documents", "type": "PipelineReference" },
        "parameters": { "full": false, "trigger": "blob_event" }
      }
    ]
  }
}
