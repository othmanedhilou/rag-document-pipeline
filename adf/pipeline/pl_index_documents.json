{
  "name": "pl_index_documents",
  "properties": {
    "description": "Incremental indexing of the documents container: plan, process changed files in parallel, finalize.",
    "concurrency": 1,
    "parameters": {
      "full": { "type": "bool", "defaultValue": false },
      "trigger": { "type": "string", "defaultValue": "manual" }
    },
    "activities": [
      {
        "name": "Plan",
        "type": "AzureFunctionActivity",
        "policy": { "timeout": "0.00:10:00", "retry": 2, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "functionName": "plan",
          "method": "POST",
          "body": {
            "value": "@json(concat('{\"full\":', if(pipeline().parameters.full, 'true', 'false'), '}'))",
            "type": "Expression"
          }
        },
        "linkedServiceName": { "referenceName": "ls_function_docpipe", "type": "LinkedServiceReference" }
      },
      {
        "name": "ProcessDocuments",
        "type": "ForEach",
        "dependsOn": [{ "activity": "Plan", "dependencyConditions": ["Succeeded"] }],
        "typeProperties": {
          "items": { "value": "@activity('Plan').output.to_process", "type": "Expression" },
          "isSequential": false,
          "batchCount": 4,
          "activities": [
            {
              "name": "ProcessDocument",
              "type": "AzureFunctionActivity",
              "policy": { "timeout": "0.00:10:00", "retry": 2, "retryIntervalInSeconds": 60 },
              "typeProperties": {
                "functionName": "process",
                "method": "POST",
                "body": {
                  "value": "@json(concat('{\"run_id\":\"', activity('Plan').output.run_id, '\",\"path\":\"', item().path, '\",\"size\":', string(item().size), ',\"modified\":\"', item().modified, '\",\"action\":\"', item().action, '\",\"full\":', if(pipeline().parameters.full, 'true', 'false'), '}'))",
                  "type": "Expression"
                }
              },
              "linkedServiceName": { "referenceName": "ls_function_docpipe", "type": "LinkedServiceReference" }
            }
          ]
        }
      },
      {
        "name": "Finalize",
        "type": "AzureFunctionActivity",
        "dependsOn": [{ "activity": "ProcessDocuments", "dependencyConditions": ["Completed"] }],
        "policy": { "timeout": "0.00:10:00", "retry": 2, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "functionName": "finalize",
          "method": "POST",
          "body": {
            "value": "@json(concat('{\"run_id\":\"', activity('Plan').output.run_id, '\",\"started_at\":\"', activity('Plan').output.started_at, '\",\"seen\":', string(activity('Plan').output.seen), ',\"unchanged\":', string(activity('Plan').output.unchanged), ',\"trigger\":\"', pipeline().parameters.trigger, '\",\"deleted\":', string(activity('Plan').output.deleted), '}'))",
            "type": "Expression"
          }
        },
        "linkedServiceName": { "referenceName": "ls_function_docpipe", "type": "LinkedServiceReference" }
      }
    ],
    "annotations": ["rag", "indexing"]
  }
}
